-- SQ-Style LED Meter
-- A single LED per channel whose color follows the audio level on a
-- blue-to-red gradient, like the signal LEDs on an Allen & Heath SQ console.
--
-- Install: copy this file to  Documents\QSC\Q-Sys Designer\Plugins\
-- then restart Designer. It appears under Plugins > Meters.

PluginInfo = {
  Name = "Meters~SQ-Style LED Meter",
  Version = "2.3",
  BuildVersion = "2.3.0.0",
  Id = "d43521a9-1f80-4857-89ea-9bc31db51c52",
  Author = "danleafblad",
  Description = "Single LED per channel that changes color from blue to red with audio level",
  ShowDebug = true,
}

---------------------------------------------------------------------------
-- Shared definitions (used at design time and at runtime)
---------------------------------------------------------------------------

-- Color stops: position along the level range (0 = Min dB, 1 = Max dB), then R, G, B
SCHEMES = {
  ["Blue to Red (SQ)"] = {
    { 0.00, 0x00, 0x30, 0xFF },  -- deep blue
    { 0.40, 0x00, 0xB4, 0xFF },  -- light blue
    { 0.65, 0x00, 0xE0, 0x60 },  -- green
    { 0.80, 0xFF, 0xD0, 0x00 },  -- yellow
    { 0.90, 0xFF, 0x70, 0x00 },  -- orange
    { 1.00, 0xFF, 0x00, 0x00 },  -- red
  },
  ["Blue to Red (no green)"] = {
    { 0.00, 0x00, 0x30, 0xFF },
    { 0.55, 0x00, 0xB4, 0xFF },
    { 0.80, 0xC0, 0x40, 0xFF },  -- violet
    { 0.90, 0xFF, 0x40, 0x80 },  -- pink
    { 1.00, 0xFF, 0x00, 0x00 },
  },
  ["Green to Red (Classic)"] = {
    { 0.00, 0x00, 0xC0, 0x30 },
    { 0.70, 0x40, 0xFF, 0x40 },
    { 0.85, 0xFF, 0xD0, 0x00 },
    { 1.00, 0xFF, 0x00, 0x00 },
  },
}
SCHEME_NAMES = { "Blue to Red (SQ)", "Blue to Red (no green)", "Green to Red (Classic)" }

-- Returns {R, G, B} for position t (0..1) along the gradient
function GradientRGB(stops, t)
  if t <= stops[1][1] then return { stops[1][2], stops[1][3], stops[1][4] } end
  for k = 2, #stops do
    local a, b = stops[k - 1], stops[k]
    if t <= b[1] then
      local f = (t - a[1]) / (b[1] - a[1])
      local function ch(i) return math.floor(a[i] + (b[i] - a[i]) * f + 0.5) end
      return { ch(2), ch(3), ch(4) }
    end
  end
  local last = stops[#stops]
  return { last[2], last[3], last[4] }
end

function ToHex(rgb)
  return string.format("#%02X%02X%02X", rgb[1], rgb[2], rgb[3])
end

-- Color shown when there is no signal (below Min dB)
OFF_RGB = { 0x10, 0x14, 0x22 }

---------------------------------------------------------------------------
-- Design-time functions
---------------------------------------------------------------------------

function GetColor(props)
  return { 0, 90, 200 }
end

function GetPrettyName(props)
  return "SQ-Style LED Meter\n" .. props["Channels"].Value .. " ch"
end

PageNames = { "LEDs", "Setup" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  return {
    { Name = "Channels", Type = "integer", Min = 1, Max = 64, Value = 8 },
    { Name = "Color Scheme", Type = "enum", Choices = SCHEME_NAMES, Value = SCHEME_NAMES[1] },
    { Name = "LED Shape", Type = "enum", Choices = { "Round", "Square" }, Value = "Round" },
    { Name = "LED Size", Type = "integer", Min = 12, Max = 128, Value = 36 },
    { Name = "Off Below (dB)", Type = "integer", Min = -100, Max = 0, Value = -48 },
    { Name = "Full Red At (dB)", Type = "integer", Min = -60, Max = 20, Value = 0 },
    { Name = "Release (dB/s)", Type = "integer", Min = 1, Max = 200, Value = 20 },
    -- Log: prints each channel's level and LED color once a second.
    -- Color Sweep: ignores the inputs and cycles every LED through the gradient.
    { Name = "Diagnostics", Type = "enum", Choices = { "Off", "Log", "Color Sweep" }, Value = "Off" },
  }
end

function RectifyProperties(props)
  return props
end

function GetPins(props)
  return {}
end

function GetControls(props)
  local ctrls = {}
  for c = 1, props["Channels"].Value do
    -- Level input: wire a meter's output control pin here
    table.insert(ctrls, {
      Name = "level_" .. c, ControlType = "Knob", ControlUnit = "dB",
      Min = -100, Max = 20, UserPin = true, PinStyle = "Input",
    })
    -- Optional: read a named component instead of the pin
    table.insert(ctrls, { Name = "comp_" .. c, ControlType = "Text", UserPin = false, PinStyle = "None" })
    table.insert(ctrls, { Name = "ctrl_" .. c, ControlType = "Text", UserPin = false, PinStyle = "None" })
    table.insert(ctrls, { Name = "name_" .. c, ControlType = "Text", UserPin = true, PinStyle = "Input" })
    table.insert(ctrls, {
      Name = "led_" .. c, ControlType = "Indicator", IndicatorType = "Led",
      UserPin = false, PinStyle = "None",
    })
  end

  table.insert(ctrls, {
    Name = "Status", ControlType = "Indicator", IndicatorType = "Status",
    UserPin = true, PinStyle = "Output",
  })
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local page = PageNames[props["page_index"].Value]
  local channels = props["Channels"].Value
  local size = props["LED Size"].Value
  local round = props["LED Shape"].Value == "Round"
  local stops = SCHEMES[props["Color Scheme"].Value]

  if page == "LEDs" then
    local pitch = math.max(size, 40) + 12
    local nameH = 18
    local top = 32
    local width = channels * pitch + 12
    local height = top + size + 6 + nameH + 10

    table.insert(graphics, {
      Type = "GroupBox", Fill = { 22, 22, 26 }, StrokeWidth = 0, CornerRadius = 6,
      Position = { 0, 0 }, Size = { width, height },
    })
    table.insert(graphics, {
      Type = "Text", Text = "SQ-Style LED Meter", Color = { 200, 200, 210 },
      FontSize = 12, HTextAlign = "Left", Position = { 8, 6 }, Size = { math.max(width - 16, 120), 20 },
    })

    for c = 1, channels do
      local cx = 6 + (c - 1) * pitch + math.floor(pitch / 2)
      layout["led_" .. c] = {
        PrettyName = "Ch " .. c .. "~LED",
        Style = "Led",
        Position = { cx - math.floor(size / 2), top }, Size = { size, size },
        Color = GradientRGB(stops, 0), OffColor = OFF_RGB, UnlinkOffColor = true,
        StrokeWidth = 1, StrokeColor = { 60, 60, 70 },
        CornerRadius = round and math.floor(size / 2) or 3, Margin = 0,
      }
      layout["name_" .. c] = {
        PrettyName = "Ch " .. c .. "~Name", Style = "Text",
        Position = { cx - math.floor((pitch - 6) / 2), top + size + 6 }, Size = { pitch - 6, nameH },
        FontSize = 9, Color = { 40, 40, 46 }, TextColor = { 230, 230, 230 },
      }
    end

  elseif page == "Setup" then
    local y = 8
    local cols = { { "Ch", 30 }, { "Name", 90 }, { "Component", 120 }, { "Control", 90 }, { "Level In", 64 } }
    local x = 8
    for _, col in ipairs(cols) do
      table.insert(graphics, {
        Type = "Text", Text = col[1], FontSize = 11, HTextAlign = "Left",
        Position = { x, y }, Size = { col[2], 18 },
      })
      x = x + col[2] + 4
    end
    y = y + 22

    for c = 1, channels do
      x = 8
      table.insert(graphics, {
        Type = "Text", Text = tostring(c), FontSize = 11, HTextAlign = "Left",
        Position = { x, y }, Size = { cols[1][2], 18 },
      })
      x = x + cols[1][2] + 4
      layout["name_" .. c] = { PrettyName = "Ch " .. c .. "~Name", Style = "Text", Position = { x, y }, Size = { cols[2][2], 18 } }
      x = x + cols[2][2] + 4
      layout["comp_" .. c] = { PrettyName = "Ch " .. c .. "~Component", Style = "Text", Position = { x, y }, Size = { cols[3][2], 18 } }
      x = x + cols[3][2] + 4
      layout["ctrl_" .. c] = { PrettyName = "Ch " .. c .. "~Control", Style = "Text", Position = { x, y }, Size = { cols[4][2], 18 } }
      x = x + cols[4][2] + 4
      layout["level_" .. c] = { PrettyName = "Ch " .. c .. "~Level In", Style = "Text", Position = { x, y }, Size = { cols[5][2], 18 } }
      y = y + 22
    end

    y = y + 10
    local globals = {
      { "Status", "Status" },
    }
    for _, g in ipairs(globals) do
      table.insert(graphics, {
        Type = "Text", Text = g[2], FontSize = 11, HTextAlign = "Right",
        Position = { 8, y }, Size = { 160, 18 },
      })
      layout[g[1]] = {
        PrettyName = g[2], Style = "Text",
        Position = { 172, y }, Size = { g[1] == "Status" and 260 or 64, 18 },
      }
      y = y + 22
    end
  end

  return layout, graphics
end

---------------------------------------------------------------------------
-- Runtime
---------------------------------------------------------------------------

if Controls then
  local RATE = 0.05  -- 20 updates per second
  local N = Properties["Channels"].Value
  local STOPS = SCHEMES[Properties["Color Scheme"].Value]
  local FLOOR = -120
  -- Range and release are Properties, not controls: Designer doesn't apply a
  -- control's DefaultValue, so knobs would start at their Min values.
  local LO = Properties["Off Below (dB)"].Value
  local HI = math.max(Properties["Full Red At (dB)"].Value, LO + 1)
  local FALL = Properties["Release (dB/s)"].Value * RATE
  print(string.format("SQ-Style LED Meter: off below %d dB, full red at %d dB, release %d dB/s",
    LO, HI, Properties["Release (dB/s)"].Value))

  local ch = {}
  for c = 1, N do
    ch[c] = { display = FLOOR, led = Controls["led_" .. c], color = nil, on = nil, src = nil, err = nil }
  end

  local function updateStatus()
    local errs = {}
    for c = 1, N do
      if ch[c].err then table.insert(errs, "Ch " .. c .. ": " .. ch[c].err) end
    end
    if #errs == 0 then
      Controls.Status.Value = 0
      Controls.Status.String = ""
    else
      Controls.Status.Value = 2
      Controls.Status.String = table.concat(errs, "; ")
    end
  end

  -- Resolve the named component/control for a channel, if one is set
  local function bind(c)
    local compName = Controls["comp_" .. c].String
    local ctrlName = Controls["ctrl_" .. c].String
    ch[c].src, ch[c].err = nil, nil
    if compName == "" then return end
    if ctrlName == "" then
      ch[c].err = "no control name set for '" .. compName .. "'"
      return
    end
    local ok, ctl = pcall(function() return Component.New(compName)[ctrlName] end)
    if ok and ctl then
      ch[c].src = ctl
    else
      ch[c].err = "can't find '" .. compName .. "' / '" .. ctrlName .. "' (check Code Name and Script Access)"
    end
  end

  for c = 1, N do
    local function rebind() bind(c); updateStatus() end
    Controls["comp_" .. c].EventHandler = rebind
    Controls["ctrl_" .. c].EventHandler = rebind
    bind(c)
  end
  updateStatus()

  local DIAG = Properties["Diagnostics"].Value
  local ticks = 0

  -- Sets one channel's LED from a position along the gradient (nil = off)
  local function show(m, t)
    local on = t ~= nil
    if on then
      local color = ToHex(GradientRGB(STOPS, t))
      if color ~= m.color then
        m.led.Color = color
        m.color = color
      end
    end
    if on ~= m.on then
      m.led.Boolean = on
      m.on = on
    end
  end

  local function sweep()
    local t = (ticks % 80) / 79  -- bottom to top every 4 seconds
    for c = 1, N do show(ch[c], t) end
    if ticks % 20 == 0 then
      print(string.format("sweep t=%.2f color=%s led_1.Color reads back %s",
        t, ToHex(GradientRGB(STOPS, t)), tostring(ch[1].led.Color)))
    end
  end

  local function meter()
    for c = 1, N do
      local m = ch[c]
      local lvl = m.src and m.src.Value or Controls["level_" .. c].Value

      -- Ballistics: instant attack, constant-rate release, so the color
      -- glides back down instead of flickering with every transient
      if lvl >= m.display then
        m.display = lvl
      else
        m.display = math.max(lvl, m.display - FALL)
      end

      if m.display >= LO then
        show(m, math.min((m.display - LO) / (HI - LO), 1))
      else
        show(m, nil)
      end

      if DIAG == "Log" and ticks % 20 == 0 then
        print(string.format("ch %d: in=%s level=%.1f display=%.1f led=%s color=%s (reads back %s)",
          c, m.src and "component" or "pin", lvl, m.display, tostring(m.on),
          tostring(m.color), tostring(m.led.Color)))
      end
    end
  end

  local lastErr = nil
  local function tick()
    ticks = ticks + 1
    local ok, err = pcall(DIAG == "Color Sweep" and sweep or meter)
    if not ok and err ~= lastErr then
      print("SQ-Style LED Meter error: " .. tostring(err))
      Controls.Status.Value = 2
      Controls.Status.String = "Script error: " .. tostring(err)
    end
    lastErr = (not ok) and err or nil
  end

  print("SQ-Style LED Meter " .. PluginInfo.Version .. ": " .. N .. " channels, diagnostics " .. DIAG)
  -- Must be global: a local timer is garbage collected once this script
  -- finishes loading, which silently stops the LEDs a few seconds after start.
  MeterTimer = Timer.New()
  MeterTimer.EventHandler = tick
  MeterTimer:Start(RATE)
end
